# =============================================================================
# polymarket-arb-bot — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Mode -------------------------------------------------------------------
# The single most important flag in this file. Leave this True until you have
# genuinely finished the paper-trading validation gate (scripts/validate_paper_run.py).
PAPER_MODE=True

# --- Live trading gate --------------------------------------------------------
# Three INDEPENDENT confirmations, all required to ever place a real order.
# Flipping one of these is not a decision to make lightly, and flipping all
# three at once because "the checklist is annoying" defeats the point.
LIVE_TRADING_CONFIRMED_1=False
LIVE_TRADING_CONFIRMED_2=False
LIVE_TRADING_CONFIRMED_3=False

# --- Risk parameters ----------------------------------------------------------
MAX_POSITION_PCT=0.08
DAILY_LOSS_HALT_PCT=0.20
TOTAL_DRAWDOWN_KILL_PCT=0.40

# --- Signal thresholds ---------------------------------------------------------
EDGE_THRESHOLD_PCT=0.05
MIN_CONFIDENCE=0.85
MIN_MARKET_LIQUIDITY_USD=50000

# --- Paper trading --------------------------------------------------------------
STARTING_PAPER_BALANCE_USD=1000

# --- Telegram alerts (optional; bot runs fine without these, just no alerts) ----
# Create a bot via @BotFather, then message it once and hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Live trading credentials ----------------------------------------------------
# ONLY needed once you deliberately move past paper mode. Leave this blank for
# the entire paper-trading phase. If this is non-empty while PAPER_MODE=True,
# the app will refuse to start — that's intentional, not a bug.
# NEVER commit this. NEVER paste it into chat, a bot, or a screenshot.
POLYGON_PRIVATE_KEY=

# --- Storage ------------------------------------------------------------------
DATABASE_PATH=storage/arb_bot.db
