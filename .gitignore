.env
storage/*.db
# SQLite WAL/shm sidecar files hold live trade-DB checkpoints — never push
storage/*.db-shm
storage/*.db-wal
storage/*.db-journal
storage/*.log
*.log
# Archived DBs from debug/pre-run snapshots — raw trade data, never pushed
storage/archive/
# Recorded market-data captures for scripts/replay_arb.py — raw data, can be
# large, and can be re-recorded any time.
storage/captures/
exports/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
# Command-center frontend deps + build output
node_modules/
command_center/ui/.next/
# Runtime artifact the bot writes for the command-center API
command_center/api/live_state.json

# TypeScript incremental build cache
*.tsbuildinfo
